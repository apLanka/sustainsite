# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster> with your Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sustainsite?retryWrites=true&w=majority

# ─── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRE=24h

# ─── Cloudinary (File Storage) ────────────────────────────────────────────────
# Sign up at https://cloudinary.com — free tier is sufficient for development
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── SendGrid (Email Notifications) ──────────────────────────────────────────
# Sign up at https://sendgrid.com — free tier allows 100 emails/day
# Key must start with "SG."
SENDGRID_API_KEY=SG.your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com

# ─── Carbon Interface API (Optional) ─────────────────────────────────────────
# Used to enrich carbon emission calculations
# Sign up at https://www.carboninterface.com — free tier available
# Leave blank to use built-in calculation algorithm
CARBON_INTERFACE_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the frontend app — used to whitelist CORS requests
# Development: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Logging ──────────────────────────────────────────────────────────────────
# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Set to any value to disable rate limiting (useful for load testing)
# DISABLE_RATE_LIMIT=true

# ─── Swagger ──────────────────────────────────────────────────────────────────
# Set to "true" to hide /api-docs in production
# DISABLE_SWAGGER=true
